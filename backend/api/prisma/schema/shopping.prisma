/// One cart per signed-in user, or per guest token for visitors who are not signed in.
model Cart {
  expiresAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + interval '30 days')")) @map("expires_at")
  couponCode String? @map("coupon_code") @db.VarChar(40)
  coinsEnabled Boolean @default(false) @map("coins_enabled")
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid
  guestToken String?  @unique @map("guest_token") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  savedForLater Boolean @default(false) @map("saved_for_later")
  lastPricePaise Int? @map("last_price_paise")
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Coupon {
  code String @id @db.VarChar(40)
  discountBps Int @map("discount_bps")
  minTotalPaise Int @default(0) @map("min_total_paise")
  maxDiscountPaise Int? @map("max_discount_paise")
  startsAt DateTime @map("starts_at")
  endsAt DateTime @map("ends_at")
  active Boolean @default(true)
  @@map("coupons")
}

model WishlistItem {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

model RecentlyViewed {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  guestToken String?  @map("guest_token") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  viewedAt   DateTime @default(now()) @map("viewed_at")

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([guestToken, productId])
  @@index([userId, viewedAt])
  @@index([guestToken, viewedAt])
  @@map("recently_viewed")
}
